# ============================================================
# CloudMesh Environment Variables
# In Vite, client-side exposed variables MUST start with "VITE_"
# ============================================================

# Google Drive Integration
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
# Type: OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript Origins: http://localhost:5173 (and your production URL)
# Authorized Redirect URIs: http://localhost:5173/oauth/callback.html
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# (Optional) Google Drive API Key if using Google Picker or public endpoints
VITE_GOOGLE_API_KEY=your-google-api-key

# Microsoft OneDrive Integration
# Azure Portal -> App Registrations -> Single-Page Application (SPA)
# Redirect URI: http://localhost:5173/oauth/callback.html
VITE_ONEDRIVE_CLIENT_ID=your-onedrive-client-id

# S3 / Cloudflare R2 Integration (Optional default endpoints)
VITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
VITE_S3_DEFAULT_BUCKET=cloudmesh-bucket
